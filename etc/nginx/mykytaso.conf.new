# RECOMMENDED nginx configuration with improved rate limiting
# This fixes real IP detection and adds granular rate limiting for different endpoints

# ============================================================================
# RATE LIMITING ZONES
# ============================================================================

# General traffic limit (3 req/sec with large burst for static content)
limit_req_zone $binary_remote_addr zone=general_limit:10m rate=3r/s;

# Strict limit for authentication endpoints (prevent brute force)
# 5 login attempts per minute = ~1 per 12 seconds
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;

# Medium limit for registration/password reset (prevent spam)
# 3 requests per minute
limit_req_zone $binary_remote_addr zone=signup_limit:10m rate=3r/m;

# API/POST endpoints limit (prevent spam/abuse)
# 10 requests per second
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

# ============================================================================
# CLOUDFLARE REAL IP CONFIGURATION
# ============================================================================
# Trust Cloudflare IP ranges https://www.cloudflare.com/ips/
# IPv4
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;

# IPv6
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;

# Use CF-Connecting-IP (Cloudflare's real client IP header)
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# ============================================================================
# WWW REDIRECT SERVER
# ============================================================================
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name www.mykytaso.com;

    # Cloudflare Origin Certificate
    ssl_certificate /etc/ssl/cloudflare/mykytaso.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/mykytaso.com.key;

    rewrite ^(.*) https://mykytaso.com$1 permanent;
}

# ============================================================================
# MAIN SERVER
# ============================================================================
server {
    listen 80;
    listen [::]:80;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mykytaso.com;

    charset utf-8;
    client_max_body_size 15M;

    rewrite ^/favicon.ico$ https://mykytaso.com/static/images/favicon.ico;
    rewrite ^/favicon.png$ https://mykytaso.com/static/images/favicon_32.png;

    # Cloudflare Origin Certificate
    ssl_certificate /etc/ssl/cloudflare/mykytaso.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/mykytaso.com.key;

    # ========================================================================
    # STATIC FILES - No rate limiting
    # ========================================================================
    location /static/ {
        root /home/mykyta/mykytaso-v3/frontend/;
        gzip_static on;
        expires max;
        add_header Cache-Control "public";
    }

    # ========================================================================
    # AUTHENTICATION ENDPOINTS - Strict rate limiting
    # ========================================================================
    location ~ ^/(accounts/login|accounts/register|accounts/password-reset) {
        # LOGIN: Allow 5 attempts per minute with NO burst
        # This prevents credential stuffing and brute force attacks
        limit_req zone=auth_limit nodelay;

        # Security headers
        add_header "Strict-Transport-Security" "max-age=31536000;includeSubDomains" always;
        add_header "X-Content-Type-Options" "nosniff" always;
        add_header "Referrer-Policy" "strict-origin-when-cross-origin" always;
        add_header "Permissions-Policy" "accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()" always;

        # Proxy headers - IMPORTANT: Set X-Real-IP for Django
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_buffering off;

        proxy_pass http://0.0.0.0:8012;
    }

    # ========================================================================
    # SIGNUP/VERIFICATION ENDPOINTS - Medium rate limiting
    # ========================================================================
    location ~ ^/(accounts/verify|accounts/resend-verification) {
        # Allow 3 requests per minute with small burst
        limit_req zone=signup_limit burst=5 nodelay;

        # Security headers
        add_header "Strict-Transport-Security" "max-age=31536000;includeSubDomains" always;
        add_header "X-Content-Type-Options" "nosniff" always;
        add_header "Referrer-Policy" "strict-origin-when-cross-origin" always;
        add_header "Permissions-Policy" "accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()" always;

        # Proxy headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_buffering off;

        proxy_pass http://0.0.0.0:8012;
    }

    # ========================================================================
    # API/POST ENDPOINTS - API rate limiting
    # ========================================================================
    location ~ ^/(posts/.*/like|comments/) {
        # Allow 10 req/sec with medium burst for interactive features
        limit_req zone=api_limit burst=20 nodelay;

        # CORS and security headers
        add_header "Access-Control-Allow-Origin" "*" always;
        add_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS" always;
        add_header "Access-Control-Allow-Headers" "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range" always;
        add_header "Access-Control-Expose-Headers" "Content-Length,Content-Range" always;
        add_header "Strict-Transport-Security" "max-age=31536000;includeSubDomains" always;
        add_header "X-Content-Type-Options" "nosniff" always;
        add_header "Referrer-Policy" "strict-origin-when-cross-origin" always;
        add_header "Permissions-Policy" "accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()" always;

        # Proxy headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_buffering off;

        proxy_pass http://0.0.0.0:8012;
    }

    # ========================================================================
    # ALL OTHER TRAFFIC - General rate limiting
    # ========================================================================
    location / {
        # General limit with large burst for normal browsing
        limit_req zone=general_limit burst=50 nodelay;

        # CORS and security headers
        add_header "Access-Control-Allow-Origin" "*" always;
        add_header "Access-Control-Allow-Methods" "GET, POST, OPTIONS" always;
        add_header "Access-Control-Allow-Headers" "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range" always;
        add_header "Access-Control-Expose-Headers" "Content-Length,Content-Range" always;
        add_header "Strict-Transport-Security" "max-age=31536000;includeSubDomains" always;
        add_header "X-Content-Type-Options" "nosniff" always;
        add_header "Referrer-Policy" "strict-origin-when-cross-origin" always;
        add_header "Permissions-Policy" "accelerometer=(),camera=(),geolocation=(),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()" always;

        # Proxy headers - CRITICAL: X-Real-IP is now set!
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_buffering off;

        proxy_pass http://0.0.0.0:8012;
    }
}

# ============================================================================
# DEFAULT SERVER (404 for unknown domains)
# ============================================================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;

    # Cloudflare Origin Certificate
    ssl_certificate /etc/ssl/cloudflare/mykytaso.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/mykytaso.com.key;

    server_name _;

    return 404;
}